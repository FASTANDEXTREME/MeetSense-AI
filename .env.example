# MeetSenseAI Environment Variables
# Copy this file to .env and fill in your Groq API key (https://console.groq.com/keys).

GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-20b"

# Optional: Custom WebRTC TURN Server (not required — built-in WSS video fallback handles 4G/5G CGNAT automatically)
# TURN_URL="turns:your-turn-server.example.com:443?transport=tcp"
# TURN_USERNAME="your_turn_username"
# TURN_CREDENTIAL="your_turn_password"
